{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "render-environment/2"
    },
    "server_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "template_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "name": {
          "const": "yue2_3b_int8_convrot.safetensors"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verification": {
          "const": "file_sha256"
        },
        "file_identity": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "size",
        "sha256",
        "verification",
        "file_identity"
      ],
      "additionalProperties": false
    },
    "node_implementations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "module",
          "source_sha256"
        ],
        "additionalProperties": false
      }
    },
    "model_configuration": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "comfyui": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "root",
        "version"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object"
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "official_cli": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "executable_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "executable_sha256"
      ],
      "additionalProperties": false
    },
    "evidence_basis": {
      "const": "jr_invoked_ssh_probe"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "server_id",
    "template_sha256",
    "checkpoint",
    "node_implementations",
    "model_configuration",
    "comfyui",
    "runtime",
    "devices",
    "official_cli",
    "evidence_basis",
    "limitations",
    "fingerprint"
  ],
  "additionalProperties": false
}
